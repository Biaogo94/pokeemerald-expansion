
VerdanturfTown_BattleTentLobby_hns_MapScripts::
	map_script MAP_SCRIPT_ON_FRAME_TABLE, VerdanturfTown_BattleTentLobby_hns_OnFrame
	map_script MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE, VerdanturfTown_BattleTentLobby_hns_OnWarp
	.byte 0

VerdanturfTown_BattleTentLobby_hns_OnWarp:
	map_script_2 VAR_TEMP_1, 0, VerdanturfTown_BattleTentLobby_hns_EventScript_TurnPlayerNorth
	.2byte 0

VerdanturfTown_BattleTentLobby_hns_EventScript_TurnPlayerNorth::
	setvar VAR_TEMP_1, 1
	turnobject LOCALID_PLAYER, DIR_NORTH
	end

VerdanturfTown_BattleTentLobby_hns_OnFrame:
	map_script_2 VAR_TEMP_CHALLENGE_STATUS, 0, VerdanturfTown_BattleTentLobby_hns_EventScript_GetChallengeStatus
	map_script_2 VAR_TEMP_CHALLENGE_STATUS, CHALLENGE_STATUS_SAVING, VerdanturfTown_BattleTentLobby_hns_EventScript_QuitWithoutSaving
	map_script_2 VAR_TEMP_CHALLENGE_STATUS, CHALLENGE_STATUS_PAUSED, VerdanturfTown_BattleTentLobby_hns_EventScript_ResumeChallenge
	map_script_2 VAR_TEMP_CHALLENGE_STATUS, CHALLENGE_STATUS_WON, VerdanturfTown_BattleTentLobby_hns_EventScript_WonChallenge
	map_script_2 VAR_TEMP_CHALLENGE_STATUS, CHALLENGE_STATUS_LOST, VerdanturfTown_BattleTentLobby_hns_EventScript_LostChallenge
	.2byte 0

VerdanturfTown_BattleTentLobby_hns_EventScript_GetChallengeStatus::
	frontier_getstatus
	end

VerdanturfTown_BattleTentLobby_hns_EventScript_QuitWithoutSaving::
	lockall
	msgbox BattleFrontier_BattlePalaceLobby_Text_FailedToSaveBeforeEndingChallenge, MSGBOX_DEFAULT
	closemessage
	frontier_set FRONTIER_DATA_CHALLENGE_STATUS, 0
	setvar VAR_TEMP_CHALLENGE_STATUS, 255
	frontier_set FRONTIER_DATA_LVL_MODE, FRONTIER_LVL_50
	releaseall
	end

VerdanturfTown_BattleTentLobby_hns_EventScript_WonChallenge::
	lockall
	msgbox VerdanturfTown_BattleTentLobby_Text_AchievedThreeWinStreak, MSGBOX_DEFAULT
	message VerdanturfTown_BattleTentLobby_Text_FeatWillBeRecorded
	waitmessage
	verdanturftent_setrandomprize
	frontier_set FRONTIER_DATA_LVL_MODE, FRONTIER_LVL_50
	verdanturftent_save 0
	playse SE_SAVE
	waitse

VerdanturfTown_BattleTentLobby_hns_EventScript_GivePrize::
	msgbox VerdanturfTown_BattleTentLobby_Text_PresentYouWithPrize, MSGBOX_DEFAULT
	verdanturftent_giveprize
	switch VAR_RESULT
	case FALSE, VerdanturfTown_BattleTentLobby_hns_EventScript_NoRoomForPrize
	frontier_set FRONTIER_DATA_CHALLENGE_STATUS, 0
	message BattleFrontier_BattleDomeLobby_Text_ReceivedPrize  @ Odd that it used Dome's copy instead of Palace's
	waitmessage
	playfanfare MUS_OBTAIN_ITEM
	waitfanfare
	givebp 10
	msgbox BattleTentLobby_Text_EarnedBattlePoints, MSGBOX_DEFAULT
	msgbox VerdanturfTown_BattleTentLobby_Text_ReturnFortified, MSGBOX_DEFAULT
	closemessage
	setvar VAR_TEMP_CHALLENGE_STATUS, 255
	releaseall
	end

VerdanturfTown_BattleTentLobby_hns_EventScript_NoRoomForPrize::
	msgbox BattleFrontier_BattlePalaceLobby_Text_NoSpaceForPrize, MSGBOX_DEFAULT
	waitmessage
	closemessage
	setvar VAR_TEMP_CHALLENGE_STATUS, 255
	releaseall
	end

VerdanturfTown_BattleTentLobby_hns_EventScript_PrizeWaiting::
	lockall
	msgbox VerdanturfTown_BattleTentLobby_Text_AchievedThreeWinStreak, MSGBOX_DEFAULT
	goto VerdanturfTown_BattleTentLobby_hns_EventScript_GivePrize
	end

VerdanturfTown_BattleTentLobby_hns_EventScript_LostChallenge::
	lockall
	message VerdanturfTown_BattleTentLobby_Text_ResultsWillBeRecorded
	waitmessage
	frontier_set FRONTIER_DATA_LVL_MODE, FRONTIER_LVL_50
	verdanturftent_save 0
	playse SE_SAVE
	waitse
	msgbox VerdanturfTown_BattleTentLobby_Text_ReturnFortified, MSGBOX_DEFAULT
	closemessage
	setvar VAR_TEMP_CHALLENGE_STATUS, 255
	releaseall
	end

VerdanturfTown_BattleTentLobby_hns_EventScript_ResumeChallenge::
	lockall
	msgbox BattleFrontier_BattlePalaceLobby_Text_WeHaveBeenWaiting, MSGBOX_DEFAULT
	message BattleFrontier_BattlePalaceLobby_Text_MustSaveBeforeChallenge
	waitmessage
	verdanturftent_save CHALLENGE_STATUS_SAVING
	playse SE_SAVE
	waitse
	frontier_set FRONTIER_DATA_PAUSED, FALSE
	setvar VAR_TEMP_CHALLENGE_STATUS, 255
	goto VerdanturfTown_BattleTentLobby_hns_EventScript_EnterChallenge

VerdanturfTown_BattleTentLobby_hns_EventScript_Attendant::
	lock
	faceplayer
	verdanturftent_getprize
	goto_if_ne VAR_RESULT, ITEM_NONE, VerdanturfTown_BattleTentLobby_hns_EventScript_PrizeWaiting
	special SavePlayerParty
	msgbox VerdanturfTown_BattleTentLobby_Text_WelcomeToBattleTent, MSGBOX_DEFAULT
VerdanturfTown_BattleTentLobby_hns_EventScript_AskEnterChallenge::
	message VerdanturfTown_BattleTentLobby_Text_TakeChallenge
	waitmessage
	multichoice 17, 6, MULTI_CHALLENGEINFO, FALSE
	switch VAR_RESULT
	case 0, VerdanturfTown_BattleTentLobby_hns_EventScript_TryEnterChallenge
	case 1, VerdanturfTown_BattleTentLobby_hns_EventScript_ExplainChallenge
	case 2, VerdanturfTown_BattleTentLobby_hns_EventScript_CancelChallenge
	case MULTI_B_PRESSED, VerdanturfTown_BattleTentLobby_hns_EventScript_CancelChallenge

VerdanturfTown_BattleTentLobby_hns_EventScript_TryEnterChallenge::
	setvar VAR_FRONTIER_FACILITY, FRONTIER_FACILITY_PALACE
	setvar VAR_FRONTIER_BATTLE_MODE, FRONTIER_MODE_SINGLES
	setvar VAR_RESULT, 2
	frontier_checkineligible
	goto_if_eq VAR_0x8004, TRUE, VerdanturfTown_BattleTentLobby_hns_EventScript_NotEnoughValidMons
	frontier_set FRONTIER_DATA_LVL_MODE, FRONTIER_LVL_TENT
	msgbox VerdanturfTown_BattleTentLobby_Text_SelectThreeMons, MSGBOX_DEFAULT
	fadescreen FADE_TO_BLACK
	callnative RemoveFollowingPokemon
	setvar VAR_0x8004, 1
	setvar VAR_0x8005, FRONTIER_PARTY_SIZE
	special ChoosePartyForBattleFrontier
	waitstate
	goto_if_eq VAR_RESULT, 0, VerdanturfTown_BattleTentLobby_hns_EventScript_LoadPartyCancelChallenge
	msgbox VerdanturfTown_BattleTentLobby_Text_SaveBeforeChallenge, MSGBOX_YESNO
	switch VAR_RESULT
	case NO, VerdanturfTown_BattleTentLobby_hns_EventScript_LoadPartyCancelChallenge
	case YES, VerdanturfTown_BattleTentLobby_hns_EventScript_SaveBeforeChallenge
	case MULTI_B_PRESSED, VerdanturfTown_BattleTentLobby_hns_EventScript_LoadPartyCancelChallenge

VerdanturfTown_BattleTentLobby_hns_EventScript_SaveBeforeChallenge::
	setvar VAR_TEMP_CHALLENGE_STATUS, 0
	frontier_set FRONTIER_DATA_SELECTED_MON_ORDER
	verdanturftent_init
	frontier_set FRONTIER_DATA_CHALLENGE_STATUS, CHALLENGE_STATUS_SAVING
	frontier_set FRONTIER_DATA_PAUSED, FALSE
	special LoadPlayerParty
	closemessage
	delay 2
	call Common_EventScript_SaveGame
	setvar VAR_TEMP_CHALLENGE_STATUS, 255
	goto_if_eq VAR_RESULT, 0, VerdanturfTown_BattleTentLobby_hns_EventScript_CancelChallengeSaveFailed
VerdanturfTown_BattleTentLobby_hns_EventScript_EnterChallenge::
	special SavePlayerParty
	frontier_setpartyorder FRONTIER_PARTY_SIZE
	msgbox VerdanturfTown_BattleTentLobby_Text_NowFollowMe, MSGBOX_DEFAULT
	closemessage
	call VerdanturfTown_BattleTentLobby_hns_EventScript_WalkToDoor
	warp MAP_VERDANTURF_TOWN_BATTLE_TENT_CORRIDOR_HNS, 2, 7
	setvar VAR_TEMP_CHALLENGE_STATUS, 0
	waitstate
	end

VerdanturfTown_BattleTentLobby_hns_EventScript_ExplainChallenge::
	msgbox VerdanturfTown_BattleTentLobby_Text_ExplainVerdanturfTent, MSGBOX_DEFAULT
	goto VerdanturfTown_BattleTentLobby_hns_EventScript_AskEnterChallenge

VerdanturfTown_BattleTentLobby_hns_EventScript_NotEnoughValidMons::
	switch VAR_RESULT
	case FRONTIER_LVL_50, VerdanturfTown_BattleTentLobby_hns_EventScript_NotEnoughValidMonsLv50
	case FRONTIER_LVL_OPEN, VerdanturfTown_BattleTentLobby_hns_EventScript_NotEnoughValidMonsLvOpen

VerdanturfTown_BattleTentLobby_hns_EventScript_NotEnoughValidMonsLv50::
	msgbox VerdanturfTown_BattleTentLobby_Text_NotEnoughValidMonsLv50, MSGBOX_DEFAULT
	goto VerdanturfTown_BattleTentLobby_hns_EventScript_EndCancelChallenge

VerdanturfTown_BattleTentLobby_hns_EventScript_NotEnoughValidMonsLvOpen::
	msgbox VerdanturfTown_BattleTentLobby_Text_NotEnoughValidMonsLvOpen, MSGBOX_DEFAULT
	goto VerdanturfTown_BattleTentLobby_hns_EventScript_EndCancelChallenge

VerdanturfTown_BattleTentLobby_hns_EventScript_CancelChallengeSaveFailed::
	frontier_set FRONTIER_DATA_CHALLENGE_STATUS, 0
	goto VerdanturfTown_BattleTentLobby_hns_EventScript_CancelChallenge

VerdanturfTown_BattleTentLobby_hns_EventScript_LoadPartyCancelChallenge::
	special LoadPlayerParty
VerdanturfTown_BattleTentLobby_hns_EventScript_CancelChallenge::
	msgbox VerdanturfTown_BattleTentLobby_Text_ReturnFortified, MSGBOX_DEFAULT
VerdanturfTown_BattleTentLobby_hns_EventScript_EndCancelChallenge::
	release
	end

VerdanturfTown_BattleTentLobby_hns_EventScript_WalkToDoor::
	applymovement LOCALID_VERDANTURF_TENT_HNS_ATTENDANT, VerdanturfTown_BattleTentLobby_hns_Movement_WalkToDoor
	applymovement LOCALID_PLAYER, VerdanturfTown_BattleTentLobby_hns_Movement_WalkToDoor
	waitmovement 0
	opendoor 6, 1
	waitdooranim
	applymovement LOCALID_VERDANTURF_TENT_HNS_ATTENDANT, VerdanturfTown_BattleTentLobby_hns_Movement_AttendantEnterDoor
	applymovement LOCALID_PLAYER, VerdanturfTown_BattleTentLobby_hns_Movement_PlayerEnterDoor
	waitmovement 0
	closedoor 6, 1
	waitdooranim
	return

VerdanturfTown_BattleTentLobby_hns_Movement_WalkToDoor:
	walk_up
	walk_up
	walk_up
	step_end

VerdanturfTown_BattleTentLobby_hns_Movement_AttendantEnterDoor:
	walk_up
	set_invisible
	step_end

VerdanturfTown_BattleTentLobby_hns_Movement_PlayerEnterDoor:
	walk_up
	walk_up
	set_invisible
	step_end

VerdanturfTown_BattleTentLobby_hns_EventScript_AttractGiver::
	lock
	faceplayer
	goto_if_set FLAG_RECEIVED_TM_ATTRACT, VerdanturfTown_BattleTentLobby_hns_EventScript_ReceivedAttract
	msgbox VerdanturfTown_BattleTentLobby_hns_Text_AttractionRunsDeep, MSGBOX_DEFAULT
	giveitem ITEM_TM_SAFEGUARD
	goto_if_eq VAR_RESULT, 0, Common_EventScript_ShowBagIsFull
	setflag FLAG_RECEIVED_TM_ATTRACT
	msgbox VerdanturfTown_BattleTentLobby_hns_Text_AttractionMutual, MSGBOX_DEFAULT
	release
	end

VerdanturfTown_BattleTentLobby_hns_EventScript_ReceivedAttract::
	msgbox VerdanturfTown_BattleTentLobby_hns_Text_AttractionMutual, MSGBOX_DEFAULT
	release
	end

VerdanturfTown_BattleTentLobby_hns_EventScript_Boy1::
	msgbox VerdanturfTown_BattleTentLobby_hns_Text_TaughtWhatKindsOfMoves, MSGBOX_NPC
	end

VerdanturfTown_BattleTentLobby_hns_EventScript_Boy2::
	lock
	msgbox VerdanturfTown_BattleTentLobby_hns_Text_MonsReluctantToUseDislikedMoves, MSGBOX_DEFAULT
	release
	end

VerdanturfTown_BattleTentLobby_hns_EventScript_Scott::
	lock
	faceplayer
	goto_if_set FLAG_MET_SCOTT_IN_VERDANTURF, VerdanturfTown_BattleTentLobby_hns_EventScript_ScottAlreadySpokenTo
	msgbox VerdanturfTown_BattleTentLobby_hns_Text_ScottCanMeetToughTrainers, MSGBOX_DEFAULT
	addvar VAR_SCOTT_STATE, 1
	setflag FLAG_MET_SCOTT_IN_VERDANTURF
	release
	end

VerdanturfTown_BattleTentLobby_hns_EventScript_ScottAlreadySpokenTo::
	msgbox VerdanturfTown_BattleTentLobby_hns_Text_ScottVisitRegularly, MSGBOX_DEFAULT
	release
	end

VerdanturfTown_BattleTentLobby_hns_EventScript_LittleBoy::
	lock
	msgbox VerdanturfTown_BattleTentLobby_hns_Text_GentleMonsScaryIfAngry, MSGBOX_DEFAULT
	release
	end

VerdanturfTown_BattleTentLobby_hns_EventScript_RulesBoard::
	lockall
	msgbox VerdanturfTown_BattleTentLobby_Text_RulesAreListed, MSGBOX_DEFAULT
	goto VerdanturfTown_BattleTentLobby_hns_EventScript_ReadRulesBoard
	end

VerdanturfTown_BattleTentLobby_hns_EventScript_ReadRulesBoard::
	message BattleFrontier_BattlePalaceLobby_Text_ReadWhichHeading
	waitmessage
	setvar VAR_0x8004, SCROLL_MULTI_BATTLE_TENT_RULES
	special ShowScrollableMultichoice
	waitstate
	switch VAR_RESULT
	case 0, VerdanturfTown_BattleTentLobby_hns_EventScript_RulesLevel
	case 1, VerdanturfTown_BattleTentLobby_hns_EventScript_RulesBasics
	case 2, VerdanturfTown_BattleTentLobby_hns_EventScript_RulesNature
	case 3, VerdanturfTown_BattleTentLobby_hns_EventScript_RulesMoves
	case 4, VerdanturfTown_BattleTentLobby_hns_EventScript_RulesUnderpowered
	case 5, VerdanturfTown_BattleTentLobby_hns_EventScript_RulesWhenInDanger
	case 6, VerdanturfTown_BattleTentLobby_hns_EventScript_ExitRules
	case MULTI_B_PRESSED, VerdanturfTown_BattleTentLobby_hns_EventScript_ExitRules
	end

VerdanturfTown_BattleTentLobby_hns_EventScript_RulesLevel::
	msgbox BattleTentLobby_Text_ExplainLevelRules, MSGBOX_DEFAULT
	goto VerdanturfTown_BattleTentLobby_hns_EventScript_ReadRulesBoard
	end

VerdanturfTown_BattleTentLobby_hns_EventScript_RulesBasics::
	msgbox BattleFrontier_BattlePalaceLobby_Text_ExplainRulesBasics, MSGBOX_DEFAULT
	goto VerdanturfTown_BattleTentLobby_hns_EventScript_ReadRulesBoard
	end

VerdanturfTown_BattleTentLobby_hns_EventScript_RulesNature::
	msgbox BattleFrontier_BattlePalaceLobby_Text_ExplainRulesNature, MSGBOX_DEFAULT
	goto VerdanturfTown_BattleTentLobby_hns_EventScript_ReadRulesBoard
	end

VerdanturfTown_BattleTentLobby_hns_EventScript_RulesMoves::
	msgbox BattleFrontier_BattlePalaceLobby_Text_ExplainRulesMoves, MSGBOX_DEFAULT
	goto VerdanturfTown_BattleTentLobby_hns_EventScript_ReadRulesBoard
	end

VerdanturfTown_BattleTentLobby_hns_EventScript_RulesUnderpowered::
	msgbox BattleFrontier_BattlePalaceLobby_Text_ExplainRulesUnderpowered, MSGBOX_DEFAULT
	goto VerdanturfTown_BattleTentLobby_hns_EventScript_ReadRulesBoard
	end

VerdanturfTown_BattleTentLobby_hns_EventScript_RulesWhenInDanger::
	msgbox BattleFrontier_BattlePalaceLobby_Text_ExplainRulesWhenInDanger, MSGBOX_DEFAULT
	goto VerdanturfTown_BattleTentLobby_hns_EventScript_ReadRulesBoard
	end

VerdanturfTown_BattleTentLobby_hns_EventScript_ExitRules::
	releaseall
	end

VerdanturfTown_BattleTentLobby_hns_Text_MonsReluctantToUseDislikedMoves:
	.string "如果宝可梦不喜欢某个招式，它就会\n"
	.string "很不情愿去用。\p"
	.string "不管那个招式有多强大也一样。\p"
	.string "比如，性格[温和]的宝可梦大概不\n"
	.string "会喜欢去伤害对手。\p"
	.string "如果它看起来无法发挥实力，很可能\n"
	.string "是被迫使用了讨厌的招式。$"

VerdanturfTown_BattleTentLobby_hns_Text_GentleMonsScaryIfAngry:
	.string "我姐姐平时很温柔。但她一生起气\n"
	.string "来，真的超级超级可怕！\p"
	.string "我敢说温和的宝可梦生起气来肯定也\n"
	.string "很可怕！$"

VerdanturfTown_BattleTentLobby_hns_Text_AttractionRunsDeep:
	.string "我对宝可梦的深情......这份\n"
	.string "吸引力如此深沉......\p"
	.string "哎呀，你没看到吧？算了，没关系。\p"
	.string "你想不想要这个招式学习器，让你的\n"
	.string "宝可梦学会呢？$"

VerdanturfTown_BattleTentLobby_hns_Text_AttractionMutual:
	.string "我对宝可梦的深情......我相\n"
	.string "信我们是心意相通、互相吸引的！\p"
	.string "它们对战时的表现完全符合我的心\n"
	.string "意！$"

VerdanturfTown_BattleTentLobby_hns_Text_TaughtWhatKindsOfMoves:
	.string "你都教了你的宝可梦什么招式？\p"
	.string "我觉得如果它们掌握了回复体力或保\n"
	.string "护自己的手段，你就能占据优势。$"

VerdanturfTown_BattleTentLobby_hns_Text_ScottCanMeetToughTrainers:
	.string "亚希达：嗨，{PLAYER}\n"
	.string "{KUN}！我就猜到会在这里遇到\l"
	.string "你。\p"
	.string "对战帐篷可是个能遇见强劲训练家的\n"
	.string "地方。\p"
	.string "不管规则如何，也不管对战以何种形\n"
	.string "式展开。\p"
	.string "{PLAYER}{KUN}，我期\n"
	.string "待着你能发挥出自己的最高水平！$"

VerdanturfTown_BattleTentLobby_hns_Text_ScottVisitRegularly:
	.string "亚希达：我经常来这里，就是希望能\n"
	.string "亲眼目睹强劲训练家在各种局面下的\l"
	.string "精彩表现。$"
