PokemonJournal_Text_SpecialFeatureBrock::
	.string "《宝可梦周刊》\p"
	.string "深灰道馆馆主小刚特辑！\p"
	.string "平时不苟言笑的小刚，据说一笑起来\n"
	.string "就停不下来。$"

PokemonJournal_Text_SpecialFeatureMisty::
	.string "《宝可梦周刊》\p"
	.string "华蓝道馆馆主小霞特辑！\p"
	.string "据说小霞十分崇拜四天王中的科拿。$"

PokemonJournal_Text_SpecialFeatureLtSurge::
	.string "《宝可梦周刊》\p"
	.string "枯叶道馆馆主马志士特辑！\p"
	.string "传闻马志士还在美国老家时曾是一名\n"
	.string "飞行员。\p"
	.string "他曾利用宝可梦产生的电力来驱动他\n"
	.string "的飞机。$"

PokemonJournal_Text_SpecialFeatureErika::
	.string "《宝可梦周刊》\p"
	.string "玉虹道馆馆主莉佳特辑！\p"
	.string "传闻只要朝玉虹道馆里偷瞄，就经常\n"
	.string "能看到莉佳在打瞌睡。$"

PokemonJournal_Text_SpecialFeatureKoga::
	.string "《宝可梦周刊》\p"
	.string "浅红道馆馆主阿桔特辑！\p"
	.string "据说阿桔对医药有着极为深厚的造诣\n"
	.string "。\p"
	.string "他甚至会亲自配药来为自己的宝可梦\n"
	.string "调理身体。$"

PokemonJournal_Text_SpecialFeatureSabrina::
	.string "《宝可梦周刊》\p"
	.string "金黄道馆馆主娜姿特辑！\p"
	.string "大家都说娜姿在对战时即使不开口，\n"
	.string "也能与宝可梦心意相通。$"

PokemonJournal_Text_SpecialFeatureBlaine::
	.string "《宝可梦周刊》\p"
	.string "红莲道馆馆主夏伯特辑！\p"
	.string "据说夏伯只有在构思新的谜题时，才\n"
	.string "会摘下他的深色墨镜。$"

PokemonJournal_Text_SpecialFeatureLorelei::
	.string "《宝可梦周刊》\p"
	.string "四天王科拿特辑！\p"
	.string "以沉着冷静、精于算计的对战风格闻\n"
	.string "名的科拿，其实有着令人意外的秘密\l"
	.string "！$"

PokemonJournal_Text_SpecialFeatureBruno::
	.string "《宝可梦周刊》\p"
	.string "四天王希巴特辑！\p"
	.string "希巴之所以加入四天王，据说是为了\n"
	.string "能与最顶尖的训练家交手而燃起了熊\l"
	.string "熊斗志。$"

PokemonJournal_Text_SpecialFeatureAgatha::
	.string "《宝可梦周刊》\p"
	.string "四天王菊子特辑！\p"
	.string "菊子在年轻时曾与大木博士为了争夺\n"
	.string "最强训练家之名而针锋相对。$"

PokemonJournal_Text_SpecialFeatureLance::
	.string "《宝可梦周刊》\p"
	.string "四天王阿渡特辑！\p"
	.string "据说阿渡的祖父是名扬四海的驯龙一\n"
	.string "族长老。$"

PokemonJournal_Text_SpecialFeatureProfOak::
	.string "《宝可梦周刊》\p"
	.string "宝可梦研究巨擘--大木博士特辑！\p"
	.string "据报道，大木博士如今与孙女奈奈美\n"
	.string "以及孙子{RIVAL}生活在一起\l"
	.string "。$"

PokemonJournal_Text_SpecialFeatureDaisyOak::
	.string "这是一份很多年前的《宝可梦周刊》\n"
	.string "......\p"
	.string "《宝可梦周刊》华丽大赛特辑！\p"
	.string "春季宝可梦华丽大赛的总冠军是来自\n"
	.string "真新镇的大木奈奈美！$"

PokemonJournal_Text_SpecialFeatureMrFuji::
	.string "《宝可梦周刊》\p"
	.string "宝可梦之家的富士老人特辑！\p"
	.string "主编注：生性害羞的富士老人回绝了\n"
	.string "我们的采访请求。\p"
	.string "他是一位慈祥的老人，在紫苑镇深受\n"
	.string "居民们的爱戴与尊敬。$"
