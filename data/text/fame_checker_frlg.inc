	.string "{COLOR BLUE}\n"
	.string "{SHADOW LIGHT_BLUE}\l"
	.string "菊子$"

gFameCheckerPersonQuote_Agatha:: @ 0x81B08FB
	.string "{COLOR BLUE}\n"
	.string "{SHADOW LIGHT_BLUE}\l"
	.string "寄件人：菊子收件人：\l"
	.string "{PLAYER}\p"
	.string "{FONT_FEMALE}\n"
	.string "{COLOR DARK_GRAY}\l"
	.string "{SHADOW LIGHT_GRAY}\l"
	.string "等你上了年纪，可千万别像大木那个\l"
	.string "老顽固一样变得心慈手软！\p"
	.string "要像我一样，把战斗一直进行到底！$"

gFameCheckerPersonName_Lance:: @ 0x81B097F
	.string "{COLOR BLUE}\n"
	.string "{SHADOW LIGHT_BLUE}\l"
	.string "阿渡$"

gFameCheckerPersonQuote_Lance:: @ 0x81B098B
	.string "{COLOR BLUE}\n"
	.string "{SHADOW LIGHT_BLUE}\l"
	.string "寄件人：阿渡收件人：\l"
	.string "{PLAYER}\p"
	.string "{FONT_MALE}\n"
	.string "{COLOR DARK_GRAY}\l"
	.string "{SHADOW LIGHT_GRAY}\l"
	.string "我正在考虑回一趟故乡。\p"
	.string "我想重新磨炼我的龙属性宝可梦，让\n"
	.string "它们变得更加强大。\p"
	.string "总有一天，我想邀请你去我的故乡看\n"
	.string "看。$"

gFameCheckerPersonName_Bill:: @ 0x81B0A45
	.string "{COLOR BLUE}\n"
	.string "{SHADOW LIGHT_BLUE}\l"
	.string "正辉$"

gFameCheckerPersonQuote_Bill:: @ 0x81B0A50
	.string "{COLOR BLUE}\n"
	.string "{SHADOW LIGHT_BLUE}\l"
	.string "寄件人：正辉收件人：\l"
	.string "{PLAYER}\p"
	.string "{FONT_MALE}\n"
	.string "{COLOR DARK_GRAY}\l"
	.string "{SHADOW LIGHT_GRAY}\l"
	.string "哟！锦辉那家伙把你夸上了天呢。\p"
	.string "听得我也跟着高兴起来了。\p"
	.string "要是抓到了稀有的宝可梦，可要拿来\n"
	.string "给我瞧瞧哦？说好了！$"

